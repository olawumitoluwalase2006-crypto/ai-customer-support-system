# ========================================================
# AI-Powered Customer Support System Environment Variables
# ========================================================

# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Port (local development)
PORT=3001
